{
  "name": "candly-ship",
  "version": "0.1.0",
  "private": true,
  "description": "Candly Ship — Shopify → GT Courier (Pegasus) voucher middleware for candly.gr",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "hash-password": "node scripts/hash-password.mjs",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "db:up": "docker compose up -d db"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "iron-session": "^8.0.4",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
