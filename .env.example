# ─── App ────────────────────────────────────────────────────────────────
# Public URL of this app (used for the GT login redirect and Shopify webhooks)
APP_URL=https://ship.candly.gr
# 32+ random chars. Encrypts GT tokens + signs the session cookie.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-64-hex-chars
# bcrypt hash of the admin password, base64 encoded:  npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=

# ─── Database ───────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://candly:change-me@localhost:5432/candly_ship

# ─── Shopify (read-only custom app) ─────────────────────────────────────
# e.g. candly-gr.myshopify.com  (the *.myshopify.com domain, not candly.gr)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-10
# Option A: a static Admin API access token (shpat_...)
SHOPIFY_ADMIN_TOKEN=
# Option B: Dev Dashboard app credentials (token fetched with the client-credentials grant)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Secret used to verify webhook HMAC. For Dev Dashboard apps this is the client secret.
SHOPIFY_WEBHOOK_SECRET=

# ─── GT Courier (Pegasus Web App REST API) ──────────────────────────────
# Base host of GT Courier's Pegasus installation, without /api. e.g. https://gtcourier.pegasus.gr
GT_API_HOST=
# App code given by GT / created in Pegasus: Toolbox → Παραμετροποίηση Rest Service → App IDs
GT_APPCODE=
# Set to 1 to use a fake GT backend (local development before GT codes arrive)
GT_MOCK=0
